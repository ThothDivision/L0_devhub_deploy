# {{ ansible_managed }}
[Unit]
Description=Autheo Dev Hub (Next.js, loopback only)
After=network-online.target hive-node.service
Wants=network-online.target

[Service]
WorkingDirectory={{ autheo_devhub_runtime_dir }}/current
EnvironmentFile={{ autheo_devhub_env_file }}
Environment=PATH={{ autheo_devhub_node_dir }}:/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
Environment=HOSTNAME={{ autheo_devhub_bind }}
Environment=PORT={{ autheo_devhub_port }}
ExecStart={{ autheo_devhub_runtime_dir }}/current/node_modules/.bin/next start -H {{ autheo_devhub_bind }} -p {{ autheo_devhub_port }}
Restart=always
RestartSec=5
LimitNOFILE=1048576
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths={{ autheo_devhub_runtime_dir }}

[Install]
WantedBy=multi-user.target
