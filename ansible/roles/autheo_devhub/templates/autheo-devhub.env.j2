# {{ ansible_managed }}
# This service-side proxy is the sole source for the Dev Hub's /cloud/* calls.
# It reaches the local Hive admin ingress; no PQC telemetry is invented here.
HIVE_ADMIN={{ autheo_devhub_admin_url }}
MARKETPLACE_URL={{ autheo_devhub_marketplace_url }}
HIVE_AUTH_BYPASS={{ autheo_devhub_auth_bypass }}
{% if vault_hive_internal_token | default('') | length > 0 %}
HIVE_INTERNAL_TOKEN={{ vault_hive_internal_token }}
{% endif %}
{% if hive_owner_email | default('') | length > 0 %}
HIVE_OWNER_EMAIL={{ hive_owner_email }}
{% endif %}
{% if vault_clerk_publishable_key | default('') | length > 0 %}
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY={{ vault_clerk_publishable_key }}
{% endif %}
{% if vault_clerk_secret_key | default('') | length > 0 %}
CLERK_SECRET_KEY={{ vault_clerk_secret_key }}
{% endif %}
