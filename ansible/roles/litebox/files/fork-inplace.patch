+        let mut total = 0usize;
+        for (range, bits, _) in self.process().pm().tracked_regions() {
+            let flags = VmFlags::from_bits_truncate(bits);
+            if flags.is_empty()
+                || flags.contains(VmFlags::VM_SHARED)
+                || !flags.contains(VmFlags::VM_WRITE)
+            {
+                continue;
+            }
+            let mut start = range.start;
+            if flags.contains(VmFlags::VM_GROWSDOWN) && range.contains(&sp) {
+                start = start.max(sp.saturating_sub(512) & !0xfff);
+            }
